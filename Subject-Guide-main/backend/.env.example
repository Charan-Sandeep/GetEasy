# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/subject_guide

# Vector store (ChromaDB persistent local dir, or set CHROMA_HOST for cloud/hosted)
CHROMA_PERSIST_DIR=./chroma_data

# LLM - Groq
GROQ_API_KEY=
# Optional: change only if your Groq account supports a different model.
GROQ_MODEL=openai/gpt-oss-20b

# Auth
JWT_SECRET_KEY=replace-this-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - your frontend URL
FRONTEND_ORIGIN=http://localhost:3000
